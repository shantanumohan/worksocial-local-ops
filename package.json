{
  "name": "worksocial-operations",
  "private": true,
  "version": "0.1.0",
  "description": "WorkSocial local operations monorepo — bounded repair, after-hours inbox, content/distribution, SEO/search, knowledge/demand, monitoring, multi-model learning. Not production-activated.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": "9.15.0"
  },
  "scripts": {
    "build:local": "tsc -b packages/contracts packages/domain packages/ml packages/persistence packages/provider-adapters services/action-gateway services/credential-broker services/claude-runner services/workflow-worker services/learning-worker services/probes services/knowledge services/seo services/content services/inbox services/repair services/owner-staging services/lead-capture services/evaluation-worker services/soak apps/api apps/console services/supervisor --pretty false",
    "local:doctor": "pnpm build:local && tsx scripts/local-doctor.ts",
    "local:start": "pnpm build:local && tsx services/supervisor/src/cli.ts start",
    "local:stop": "pnpm build:local && tsx services/supervisor/src/cli.ts stop",
    "local:recover": "pnpm build:local && tsx services/supervisor/src/cli.ts recover",
    "local:health": "pnpm build:local && tsx services/supervisor/src/cli.ts health",
    "check": "tsc -b --pretty false",
    "db:migrate": "pnpm --filter @worksocial/persistence build && tsx scripts/migrate.ts",
    "test:acceptance-matrix": "tsx scripts/validate-acceptance-matrix.ts",
    "test:unit": "pnpm build:local && pnpm --filter @worksocial/domain --filter @worksocial/ml --filter @worksocial/persistence --filter @worksocial/provider-adapters --filter @worksocial/supervisor --filter @worksocial/action-gateway --filter @worksocial/credential-broker --filter @worksocial/claude-runner --filter @worksocial/workflow-worker --filter @worksocial/learning-worker --filter @worksocial/probes --filter @worksocial/knowledge --filter @worksocial/seo --filter @worksocial/content --filter @worksocial/inbox --filter @worksocial/repair --filter @worksocial/owner-staging --filter @worksocial/lead-capture --filter @worksocial/evaluation-worker --filter @worksocial/soak --filter @worksocial/api test",
    "test:database": "pnpm build:local && tsx scripts/run-database-tests.ts",
    "test:workflow": "pnpm build:local && tsx scripts/run-workflow-tests.ts",
    "test:temporal-compose": "pnpm build:local && tsx scripts/run-temporal-compose-tests.ts",
    "test:contract": "pnpm build:local && pnpm --filter @worksocial/contract-tests test",
    "test:e2e": "pnpm build:local && pnpm --filter @worksocial/e2e-lite-tests test",
    "test:soak": "pnpm build:local && pnpm --filter @worksocial/soak test",
    "test:security": "tsx scripts/stub-test.ts test:security",
    "test:eval": "tsx scripts/stub-test.ts test:eval",
    "recovery:rehearse": "pnpm build:local && tsx scripts/run-soak-recovery.ts",
    "release:evidence": "pnpm build:local && tsx scripts/run-release-evidence.ts"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "tsx": "4.19.2",
    "vitest": "2.1.8",
    "@types/node": "22.10.2"
  }
}
