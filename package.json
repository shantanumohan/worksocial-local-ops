{
  "name": "worksocial-operations",
  "private": true,
  "version": "0.1.0",
  "description": "WorkSocial local operations monorepo — monitoring probes, form-to-CRM canaries, multi-model learning. Not production-activated.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:local": "tsc -b packages/contracts packages/domain packages/ml packages/persistence packages/provider-adapters services/action-gateway services/credential-broker services/claude-runner services/workflow-worker services/learning-worker services/probes apps/api apps/console services/supervisor --pretty false",
    "local:doctor": "pnpm build:local && tsx scripts/local-doctor.ts",
    "local:start": "pnpm build:local && tsx services/supervisor/src/cli.ts start",
    "local:stop": "pnpm build:local && tsx services/supervisor/src/cli.ts stop",
    "local:health": "pnpm build:local && tsx services/supervisor/src/cli.ts health",
    "check": "tsc -b --pretty false",
    "test:unit": "pnpm build:local && pnpm --filter @worksocial/domain --filter @worksocial/ml --filter @worksocial/persistence --filter @worksocial/supervisor --filter @worksocial/action-gateway --filter @worksocial/credential-broker --filter @worksocial/claude-runner --filter @worksocial/workflow-worker --filter @worksocial/learning-worker --filter @worksocial/probes --filter @worksocial/api test",
    "test:database": "tsx scripts/stub-test.ts test:database",
    "test:workflow": "tsx scripts/stub-test.ts test:workflow",
    "test:contract": "pnpm build:local && pnpm --filter @worksocial/contract-tests test",
    "test:e2e": "pnpm build:local && pnpm --filter @worksocial/e2e-lite-tests test",
    "test:security": "tsx scripts/stub-test.ts test:security",
    "test:eval": "tsx scripts/stub-test.ts test:eval",
    "recovery:rehearse": "tsx scripts/stub-test.ts recovery:rehearse",
    "release:evidence": "tsx scripts/stub-test.ts release:evidence"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "tsx": "4.19.2",
    "vitest": "2.1.8",
    "@types/node": "22.10.2"
  }
}
